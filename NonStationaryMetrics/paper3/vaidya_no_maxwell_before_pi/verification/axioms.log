ViaB.finite_reference_uniform_field_bound {q a b : ℝ} (x : ℝ → ℝ × ℝ) (m : ℝ → ℝ) (hq : 1 < q)
  (hxcont : ContinuousOn x (Set.Icc a b)) (hmcont : ContinuousOn m (Set.Icc a b)) (hr : ∀ t ∈ Set.Icc a b, 0 < (x t).1)
  (hm : ∀ t ∈ Set.Icc a b, 0 ≤ m t) :
  ∃ K,
    ∃ ε > 0,
      ∀ t ∈ Set.Icc a b,
        ∀ (y : ℝ × ℝ),
          dist y (x t) ≤ ε →
            dist (ViaB.directionField q (m t) y) (ViaB.directionField q (m t) (x t)) ≤ ↑K * dist y (x t)
ViaB.cone_escape_stable_from_regular_reference.{u_1} {P : Type u_1} [TopologicalSpace P] {q M a s β R κ δ : ℝ}
  (flows : P → ViaB.DirectionFlow q M a) (p : P) (hq : 1 < q) (has : a ≤ s) (hβ : 0 < β ∧ β < Real.pi / 2) (hκ : 0 < κ)
  (hδ : 0 < δ)
  (hmargins :
    ∀ (r m c : ℝ),
      R ≤ r →
        0 ≤ m →
          m ≤ M →
            (c ≤ 1 → ViaB.directionB q (q - 1 + 2 * m / r) c ≤ -κ) ∧
              (Real.cos β ≤ c → δ ≤ ViaB.radialSpeed q (q - 1 + 2 * m / r) c))
  (hrp : R < (flows p).radius s) (hαp : (flows p).angle s < β) (hmcont : ContinuousOn (flows p).mass (Set.Icc a s))
  (hshared : ∀ (x : P), ∀ t ∈ Set.Icc a s, (flows x).mass t = (flows p).mass t)
  (hinitial : ContinuousAt (fun x => ((flows x).radius a, (flows x).angle a)) p) :
  ∀ᶠ (x : P) in nhds p,
    (∀ t ≥ s, δ * (t - s) ≤ (flows x).radius t - (flows x).radius s) ∧
      Filter.Tendsto (flows x).radius Filter.atTop Filter.atTop
ViaB.escaping_set_isOpen_from_initial.{u_1} {P : Type u_1} [TopologicalSpace P] {q M a : ℝ}
  (flows : P → ViaB.DirectionFlow q M a) (hq : 1 < q) (hM : 0 < M)
  (hmcont : ∀ (p : P) (b : ℝ), a ≤ b → ContinuousOn (flows p).mass (Set.Icc a b))
  (hshared : ∀ (x p : P) (t : ℝ), a ≤ t → (flows x).mass t = (flows p).mass t)
  (hinitial : Continuous fun x => ((flows x).radius a, (flows x).angle a)) :
  IsOpen {p | Filter.Tendsto (flows p).radius Filter.atTop Filter.atTop}
