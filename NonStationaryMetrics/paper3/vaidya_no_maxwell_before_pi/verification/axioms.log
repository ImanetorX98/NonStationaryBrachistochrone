ViaB.cone_escape_stable_of_local_field_bound.{u_1} {P : Type u_1} [TopologicalSpace P] {q M a s β R κ δ ε : ℝ}
  (flows : P → ViaB.DirectionFlow q M a) (p : P) (has : a ≤ s) (hβ : 0 < β ∧ β < Real.pi / 2) (hκ : 0 < κ) (hδ : 0 < δ)
  (hmargins :
    ∀ (r m c : ℝ),
      R ≤ r →
        0 ≤ m →
          m ≤ M →
            (c ≤ 1 → ViaB.directionB q (q - 1 + 2 * m / r) c ≤ -κ) ∧
              (Real.cos β ≤ c → δ ≤ ViaB.radialSpeed q (q - 1 + 2 * m / r) c))
  (hrp : R < (flows p).radius s) (hαp : (flows p).angle s < β) (m : ℝ → ℝ) (K : ℝ) (hK : 0 ≤ K) (hε : 0 < ε)
  (hm : ∀ (x : P), ∀ t ∈ Set.Icc a s, (flows x).mass t = m t)
  (hfield :
    ∀ t ∈ Set.Ico a s,
      ∀ (y : ℝ × ℝ),
        dist y ((flows p).radius t, (flows p).angle t) ≤ ε →
          dist (ViaB.directionField q (m t) y) (ViaB.directionField q (m t) ((flows p).radius t, (flows p).angle t)) ≤
            K * dist y ((flows p).radius t, (flows p).angle t))
  (hinitial : ContinuousAt (fun x => ((flows x).radius a, (flows x).angle a)) p) :
  ∀ᶠ (x : P) in nhds p,
    (∀ t ≥ s, δ * (t - s) ≤ (flows x).radius t - (flows x).radius s) ∧
      Filter.Tendsto (flows x).radius Filter.atTop Filter.atTop
ViaB.finite_angle_exterior_escapes {q M a U : ℝ} (flow : ViaB.DirectionFlow q M a) (φ : ℝ → ℝ) (hq : 1 < q) (hM : 0 < M)
  (hmpositive : 0 < flow.mass a) (hexterior : ∀ t ≥ a, 2 * flow.mass t ≤ flow.radius t)
  (hmmono : MonotoneOn flow.mass (Set.Ici a))
  (hφode :
    ∀ t ≥ a, HasDerivAt φ (√(q - 1 + 2 * flow.mass t / flow.radius t) / flow.radius t * Real.sin (flow.angle t)) t)
  (hφupper : ∀ t ≥ a, φ t ≤ U) : Filter.Tendsto flow.radius Filter.atTop Filter.atTop
