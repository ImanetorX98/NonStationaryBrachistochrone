ViaB.sturm_positive {u du z dz kperp kpar : ℝ → ℝ} {a b : ℝ} (hab : a < b)
  (hu : ∀ x ∈ Set.Icc a b, HasDerivAt u (du x) x) (hz : ∀ x ∈ Set.Icc a b, HasDerivAt z (dz x) x)
  (hdu : ∀ x ∈ Set.Icc a b, HasDerivAt du (-kperp x * u x) x) (hdz : ∀ x ∈ Set.Icc a b, HasDerivAt dz (-kpar x * z x) x)
  (hgap : ∀ x ∈ Set.Ioo a b, 0 < kperp x - kpar x) (hupos : ∀ x ∈ Set.Ioc a b, 0 < u x) (hua : u a = 0) (hza : z a = 0)
  (hdza : 0 < dz a) (x : ℝ) : x ∈ Set.Ioc a b → 0 < z x
ViaB.sturm_positive_at_reference_zero {u du z dz kperp kpar : ℝ → ℝ} {a b : ℝ} (hab : a < b)
  (hu : ∀ x ∈ Set.Icc a b, HasDerivAt u (du x) x) (hz : ∀ x ∈ Set.Icc a b, HasDerivAt z (dz x) x)
  (hdu : ∀ x ∈ Set.Icc a b, HasDerivAt du (-kperp x * u x) x) (hdz : ∀ x ∈ Set.Icc a b, HasDerivAt dz (-kpar x * z x) x)
  (hgap : ∀ x ∈ Set.Ioo a b, 0 < kperp x - kpar x) (hupos : ∀ x ∈ Set.Ioo a b, 0 < u x) (hua : u a = 0) (hza : z a = 0)
  (hdza : 0 < dz a) (hub : u b = 0) (hdub : du b < 0) : 0 < z b
ViaB.covering_injective_of_one_fiber.{u_1, u_2} {E : Type u_1} {X : Type u_2} [TopologicalSpace E] [TopologicalSpace X]
  [PreconnectedSpace X] {f : E → X} (hf : IsCoveringMap f) {x₀ : X} (hone : ViaB.fiberCount f x₀ = 1) :
  Function.Injective f
ViaB.outgoing_cone_escape {q M a β : ℝ} (flow : ViaB.DirectionFlow q M a) (hq : 1 < q) (hM : 0 < M)
  (hβ : 0 < β ∧ β < Real.pi / 2) (hcone : q - 1 < q * Real.cos β ^ 2) :
  ∃ R > 2 * M,
    R < flow.radius a →
      flow.angle a < β →
        (∀ t ≥ a, R < flow.radius t ∧ flow.angle t < β) ∧ Filter.Tendsto flow.radius Filter.atTop Filter.atTop
ViaB.large_excursion_enters_angular_cone {q M a b β R κ : ℝ} (flow : ViaB.DirectionFlow q M a) (hq : 1 < q)
  (hab : a ≤ b) (hR : 2 * M < R) (hκ : 0 < κ) (hβ : 0 < β ∧ β < Real.pi / 2)
  (hB : ∀ (r m c : ℝ), R ≤ r → 0 ≤ m → m ≤ M → c ≤ 1 → ViaB.directionB q (q - 1 + 2 * m / r) c ≤ -κ)
  (hrR : ∀ t ∈ Set.Icc a b, R ≤ flow.radius t)
  (hout : 0 ≤ ViaB.radialSpeed q (q - 1 + 2 * flow.mass a / flow.radius a) (Real.cos (flow.angle a)))
  (hlarge : q * Real.pi < κ * Real.sin β * (Real.log (flow.radius b) - Real.log (flow.radius a))) :
  ∃ t ∈ Set.Icc a b, flow.angle t < β
ViaB.no_radial_horizon_limit {r w α : ℝ → ℝ} {q a : ℝ} (hq : 0 < q) (hr : ∀ t ≥ a, 0 < r t)
  (hα : ∀ t ≥ a, 0 < α t ∧ α t < Real.pi)
  (hode : ∀ t ≥ a, HasDerivAt α (Real.sin (α t) / r t * ViaB.directionB q (w t) (Real.cos (α t))) t)
  (hw : Filter.Tendsto w Filter.atTop (nhds q)) : ¬Filter.Tendsto α Filter.atTop (nhds 0)
ViaB.no_incoming_direction_limit {r w α : ℝ → ℝ} {q a : ℝ} (hq : 1 < q) (hr : ∀ t ≥ a, 0 < r t)
  (hw : ∀ t ≥ a, q - 1 ≤ w t) (hode : ∀ t ≥ a, HasDerivAt r (ViaB.radialSpeed q (w t) (Real.cos (α t))) t) :
  ¬Filter.Tendsto α Filter.atTop (nhds Real.pi)
ViaB.unbounded_radius_escapes {q M a : ℝ} (flow : ViaB.DirectionFlow q M a) (hq : 1 < q) (hM : 0 < M)
  (hunbounded : ∀ (K : ℝ), ∃ t ≥ a, K < flow.radius t) : Filter.Tendsto flow.radius Filter.atTop Filter.atTop
ViaB.bounded_exterior_flow_angle_diverges {q M a R : ℝ} (flow : ViaB.DirectionFlow q M a) (φ : ℝ → ℝ) (hq : 1 < q)
  (hmpositive : 0 < flow.mass a) (hrupper : ∀ t ≥ a, flow.radius t ≤ R)
  (hexterior : ∀ t ≥ a, 2 * flow.mass t ≤ flow.radius t) (hmmono : MonotoneOn flow.mass (Set.Ici a))
  (hφode :
    ∀ t ≥ a, HasDerivAt φ (√(q - 1 + 2 * flow.mass t / flow.radius t) / flow.radius t * Real.sin (flow.angle t)) t) :
  Filter.Tendsto φ Filter.atTop Filter.atTop
