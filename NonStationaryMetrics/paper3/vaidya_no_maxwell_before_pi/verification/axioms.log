ViaB.finite_reference_uniform_field_bound {q a b : ℝ} (x : ℝ → ℝ × ℝ) (m : ℝ → ℝ) (hq : 1 < q)
  (hxcont : ContinuousOn x (Set.Icc a b)) (hmcont : ContinuousOn m (Set.Icc a b)) (hr : ∀ t ∈ Set.Icc a b, 0 < (x t).1)
