  (hB : ∀ (r m c : ℝ), R ≤ r → 0 ≤ m → m ≤ M → c ≤ 1 → ViaB.directionB q (q - 1 + 2 * m / r) c ≤ -κ)
  (hrR : ∀ t ∈ Set.Icc a b, R ≤ flow.radius t)
  (hout : 0 ≤ ViaB.radialSpeed q (q - 1 + 2 * flow.mass a / flow.radius a) (Real.cos (flow.angle a)))
  (hlarge : q * Real.pi < κ * Real.sin β * (Real.log (flow.radius b) - Real.log (flow.radius a))) :
