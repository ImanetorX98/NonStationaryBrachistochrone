ViaB.affine_hamiltonian_to_direction {q m L Pv t : ℝ} {r p φ ℓ : ℝ → ℝ} (hq : 0 < q) (hr : 0 < r (ℓ t)) (hL : 0 < L)
  (hw : 0 < ViaB.vaidyaW q m (r (ℓ t)))
  (hnull : ViaB.cometricQuad q (ViaB.vaidyaW q m (r (ℓ t))) (r (ℓ t)) Pv (p (ℓ t)) L = 0)
  (hfuture : 0 < -Pv / ViaB.vaidyaW q m (r (ℓ t)) + p (ℓ t))
  (hℓ : HasDerivAt ℓ (1 / (-Pv / ViaB.vaidyaW q m (r (ℓ t)) + p (ℓ t))) t)
  (hr_affine : HasDerivAt r (Pv + (q - ViaB.vaidyaW q m (r (ℓ t))) * p (ℓ t)) (ℓ t))
  (hp_affine : HasDerivAt p (ViaB.radialMomentumAffine q m (r (ℓ t)) Pv (p (ℓ t)) L) (ℓ t))
  (hphi_affine : HasDerivAt φ (L / r (ℓ t) ^ 2) (ℓ t)) :
  HasDerivAt (fun v => r (ℓ v))
      (ViaB.radialSpeed q (ViaB.vaidyaW q m (r (ℓ t))) (Real.cos (ViaB.momentumAngle q (r (ℓ t)) (p (ℓ t)) L))) t ∧
    HasDerivAt (fun v => ViaB.momentumAngle q (r (ℓ v)) (p (ℓ v)) L)
        (Real.sin (ViaB.momentumAngle q (r (ℓ t)) (p (ℓ t)) L) / r (ℓ t) *
          ViaB.directionB q (ViaB.vaidyaW q m (r (ℓ t))) (Real.cos (ViaB.momentumAngle q (r (ℓ t)) (p (ℓ t)) L)))
