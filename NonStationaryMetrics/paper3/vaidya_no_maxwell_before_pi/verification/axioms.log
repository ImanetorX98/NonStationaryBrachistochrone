ViaB.outgoing_cone_escape {q M a β : ℝ} (flow : ViaB.DirectionFlow q M a) (hq : 1 < q) (hM : 0 < M)
  (hβ : 0 < β ∧ β < Real.pi / 2) (hcone : q - 1 < q * Real.cos β ^ 2) :
  ∃ R > 2 * M,
    R < flow.radius a →
      flow.angle a < β →
        (∀ t ≥ a, R < flow.radius t ∧ flow.angle t < β) ∧ Filter.Tendsto flow.radius Filter.atTop Filter.atTop
