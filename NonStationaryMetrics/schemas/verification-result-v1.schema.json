{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NSB numerical verification result, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer",
    "complete",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "complete": {
      "const": true
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "samples"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "samples": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "value"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  }
}
