% Companion entry cited BY Paper II (points to Paper I). Kept in a separate
% file so Paper I never lists itself in its own bibliography.
%
% VERSION DOI, with the concept DOI kept in the note.  The two papers are
% deposited as a matched pair: each cites the exact companion version that
% carries the results it relies on, so a reader following this reference lands
% on the text that was actually used, not on whatever supersedes it later.  The
% concept DOI 10.5281/zenodo.21739997 is given alongside and always resolves to
% the latest version, which is the same arrangement refs.bib uses for the code
% archive (version DOI in `doi`, concept DOI in the note).
%
% Previous values, for the record: 10.5281/zenodo.22206237 pinned v4 (31 August
% 2026), then the bare concept DOI was used for one round.  The current value
% pins the version deposited for the Round-2 response.
%
% On the locator: iopart-num's `misc` formatter prints howpublished, note,
% eprint and url, but NOT doi, so a bare doi field is invisible in the rendered
% bibliography.  Either `note = {\url{...}}` or a `url` field works -- the other
% Zenodo preprints in refs.bib use the first.  Both are given here.
%
% NOTE: BibTeX does not accept `%` comments INSIDE an entry -- it reports
% "You're missing a field name" and silently drops every field after the
% comment.  These comments therefore live outside the braces, where they are
% legal.  An earlier edit put them inside, which suppressed the locator and
% made it look as though the style were at fault.
@misc{PaperOne,
  author       = {Rosignoli, Iman},
  title        = {Controlled-rail brachistochrones in non-stationary
                  spacetimes: conformal symmetry, {Kodama} energy, and {Vaidya}
                  dynamics},
  year         = {2026},
  howpublished = {companion paper (Paper~I); Zenodo preprint},
  doi          = {10.5281/zenodo.22917051},
  url          = {https://doi.org/10.5281/zenodo.22917051},
  note         = {concept DOI \url{https://doi.org/10.5281/zenodo.21739997}
                  always resolves to the latest version}
}
